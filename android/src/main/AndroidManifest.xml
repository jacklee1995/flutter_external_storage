<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Only the legacy runtime permissions are declared here (merged into the host app).
      On Android 11+ (API 30+) full external storage access requires MANAGE_EXTERNAL_STORAGE,
      which is restricted by Google Play policy, so the host app must declare it itself.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

</manifest>
